<section
  class="section story-rows color-{{ section.settings.color_scheme }}"
  style="--pt: var(--space-{{ section.settings.padding_top }}); --pb: var(--space-{{ section.settings.padding_bottom }});"
>
  <div class="page-width story-rows__list">
    {% content_for 'blocks' %}
  </div>
</section>

{% stylesheet %}
  .story-rows__list {
    display: grid;
    gap: clamp(48px, 9vw, 140px);
  }
  .story-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 6vw, 96px);
    align-items: center;
  }
  .story-row--flip .story-row__media {
    order: 2;
  }
  .story-row__media {
    position: relative;
    aspect-ratio: 4 / 3.4;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }
  .story-row__media > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .story-row__copy {
    display: grid;
    gap: 18px;
    max-width: 520px;
  }
  .story-row__heading {
    font-size: calc(clamp(1.6rem, 2.6vw, 2.25rem) * var(--heading-scale));
    text-transform: none;
    letter-spacing: 0;
    line-height: 1.1;
  }
  .story-row__text {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-body);
  }
  .story-row .arrow-link {
    justify-self: start;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .story-row__media {
        animation: story-wipe linear both;
        animation-timeline: view();
        animation-range: entry 5% cover 40%;
      }
      .story-row--flip .story-row__media {
        animation-name: story-wipe-flip;
      }
      [dir='rtl'] .story-row__media {
        animation-name: story-wipe-flip;
      }
      [dir='rtl'] .story-row--flip .story-row__media {
        animation-name: story-wipe;
      }
      .story-row__media > img {
        animation: story-settle linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 60%;
      }
      .story-row__copy {
        animation: story-rise linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 35%;
      }
    }
  }
  @keyframes story-wipe {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0);
    }
  }
  @keyframes story-wipe-flip {
    from {
      clip-path: inset(0 0 0 100%);
    }
    to {
      clip-path: inset(0);
    }
  }
  @keyframes story-settle {
    from {
      scale: 1.2;
    }
    to {
      scale: 1;
    }
  }
  @keyframes story-rise {
    from {
      opacity: 0;
      translate: 0 40px;
    }
    to {
      opacity: 1;
      translate: none;
    }
  }
  @media (max-width: 749px) {
    .story-row {
      grid-template-columns: minmax(0, 1fr);
    }
    .story-row--flip .story-row__media {
      order: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Story rows",
  "tag": "section",
  "class": "story-rows-section",
  "max_blocks": 6,
  "blocks": [{ "type": "_story-row" }],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    {
      "type": "select",
      "id": "first_image",
      "label": "First photo on desktop",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "end", "label": "End" }
      ],
      "default": "start"
    },
    { "type": "checkbox", "id": "product_photos", "label": "Use product photos for rows without an image", "info": "On product pages, rows use the product's second, third and fourth photos", "default": true },
    { "type": "collection", "id": "collection", "label": "Collection for photos on other pages" },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Top padding",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    }
  ],
  "presets": [
    {
      "name": "Story rows",
      "blocks": [
        { "type": "_story-row" },
        {
          "type": "_story-row",
          "settings": {
            "heading": "Your everyday rotation",
            "text": "<p>Mix two or three pieces from the same drop for a fit that feels like yours.</p>"
          }
        },
        {
          "type": "_story-row",
          "settings": {
            "heading": "Quietly sculptural",
            "text": "<p>Tell the story behind a drop: the idea, the fabric and the details people notice.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
