{%- comment -%}
  Chapters: collections set like chapters in a catalogue. Each chapter's number and title stay
  pinned on one side while its plates scroll past on the other. On phones the plates swipe.
{%- endcomment -%}

{%- assign heading_id = 'ChaptersHeading-' | append: section.id -%}

<section
  class="section color-{{ section.settings.color_scheme }}"
  style="--pt: var(--space-{{ section.settings.padding_top }}); --pb: var(--space-{{ section.settings.padding_bottom }}); --chapter-cols: {{ section.settings.columns }};"
  {% if section.settings.heading != blank %}
    aria-labelledby="{{ heading_id }}"
  {% endif %}
>
  <div class="page-width">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      heading_id: heading_id,
      alignment: 'start'
    %}
    <div class="chapters chapters--title-{{ section.settings.title_position }}{% if section.settings.pin_titles %} chapters--pinned{% endif %}">
      {%- if section.blocks.size > 0 -%}
        {% content_for 'blocks' %}
      {%- else -%}
        <p class="chapters__empty caption">{{ 'sections.chapters.empty' | t }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .chapters {
    display: grid;
    gap: clamp(56px, 8vw, 120px);
  }
  .chapter {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr);
    gap: clamp(24px, 4vw, 72px);
    align-items: start;
  }
  .chapters--title-end .chapter__head {
    order: 2;
  }
  .chapters--pinned .chapter__head {
    position: sticky;
    top: calc(var(--header-height, 0px) + 32px);
  }
  .chapter__head {
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .chapter__no {
    margin: 0;
    font-size: 1.0625rem;
    color: var(--color-muted);
  }
  .chapter__title {
    margin: 0;
  }
  .chapter__text {
    max-width: 36ch;
    color: var(--color-body);
  }
  .chapter__link {
    justify-self: start;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .chapter__plates {
    display: grid;
    grid-template-columns: repeat(var(--chapter-cols, 2), minmax(0, 1fr));
    gap: clamp(28px, 3.4vw, 48px) var(--grid-gap);
    align-items: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chapter__plates > li:nth-child(even) {
    margin-top: clamp(0px, 6vw, 96px);
  }
  .chapters__empty {
    margin: 0;
    color: var(--color-muted);
  }
  @media (max-width: 989px) {
    .chapter {
      grid-template-columns: minmax(0, 1fr);
    }
    .chapters--title-end .chapter__head {
      order: 0;
    }
    .chapters--pinned .chapter__head {
      position: static;
    }
    .chapter__plates {
      display: flex;
      gap: 14px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
    }
    .chapter__plates > li {
      flex: 0 0 68%;
      scroll-snap-align: start;
    }
    .chapter__plates > li:nth-child(even) {
      margin-top: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Chapters",
  "tag": "div",
  "class": "chapters-section",
  "max_blocks": 6,
  "blocks": [{ "type": "_chapter" }],
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Small title" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "chapter_word", "label": "Word before chapter numbers", "default": "Chapter" },
    { "type": "range", "id": "columns", "label": "Plates per row on desktop", "min": 2, "max": 4, "step": 1, "default": 2 },
    {
      "type": "select",
      "id": "title_position",
      "label": "Chapter title",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "end", "label": "End" }
      ],
      "default": "start"
    },
    { "type": "checkbox", "id": "pin_titles", "label": "Keep the title in place while the plates scroll", "default": true },
    { "type": "checkbox", "id": "use_description", "label": "Use the collection description when a chapter has no text", "default": true },
    { "type": "header", "content": "Spacing" },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    }
  ],
  "presets": [
    {
      "name": "Chapters",
      "blocks": [{ "type": "_chapter" }, { "type": "_chapter" }]
    }
  ]
}
{% endschema %}
