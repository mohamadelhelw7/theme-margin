{%- comment -%}
  Plate hero: a photo (or two as a spread, or a video) set like a catalogue plate, with an italic
  caption under it and the heading, text and links beside or below it in wide white margins.
{%- endcomment -%}

{%- liquid
  assign hero_image = section.settings.image | default: section.settings.image_mobile
  assign has_media = false
  if hero_image != blank or section.settings.video != blank
    assign has_media = true
  endif
  assign show_media = true
  if has_media == false and settings.placeholder_text_heroes
    assign show_media = false
  endif
  assign hero_alt = section.settings.heading | remove: '*' | strip_newlines
  assign media_class = 'phero__media phero__media--' | append: section.settings.height
  assign media_style = ''
  if section.settings.height == 'adapt' or section.settings.height == 'ratio'
    assign media_class = media_class | append: ' hero-fit'
    capture media_style
      render 'hero-ratio', mode: section.settings.height, ratio: section.settings.aspect_ratio, ratio_mobile: section.settings.aspect_ratio_mobile, video: section.settings.video, image: hero_image, image_2: section.settings.image_2, image_mobile: section.settings.image_mobile
    endcapture
  endif
  assign media_sizes = '(min-width: 990px) 60vw, 100vw'
  if section.settings.layout == 'stacked'
    assign media_sizes = '100vw'
  endif
-%}

<section
  class="phero phero--{{ section.settings.layout }} phero--media-{{ section.settings.media_position }}{% unless show_media %} phero--text-only{% endunless %} color-{{ section.settings.color_scheme }}"
  style="--pt: var(--space-{{ section.settings.padding_top }}); --pb: var(--space-{{ section.settings.padding_bottom }});"
  data-no-reveal
>
  <div class="phero__inner page-width">
    {%- if show_media -%}
      <figure class="phero__plate">
        <div class="{{ media_class }}"{% if media_style != blank %} style="{{ media_style | strip }}"{% endif %}>
          {%- if has_media -%}
            {% render 'hero-media',
              video: section.settings.video,
              image: hero_image,
              image_2: section.settings.image_2,
              image_mobile: section.settings.image_mobile,
              alt: hero_alt,
              sizes: media_sizes
            %}
          {%- else -%}
            {% render 'media-placeholder', kind: 'hero' %}
          {%- endif -%}
        </div>
        {%- if section.settings.caption != blank or section.settings.caption_end != blank -%}
          <figcaption class="phero__caption">
            <span class="caption">{{ section.settings.caption | escape }}</span>
            <span class="caption">{{ section.settings.caption_end | escape }}</span>
          </figcaption>
        {%- endif -%}
      </figure>
    {%- endif -%}

    <div class="phero__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="phero__eyebrow caption">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="phero__heading h1">
          {%- assign lines = section.settings.heading | newline_to_br | split: '<br />' -%}
          {%- for line in lines -%}
            <span class="phero__line"><span style="--line: {{ forloop.index0 }};">{% render 'accent-text', text: line %}</span></span>
          {%- endfor -%}
        </h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="phero__copy rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
        <div class="phero__links">
          {%- if section.settings.button_label != blank -%}
            <a class="button button--{{ section.settings.button_style }}" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a class="phero__link" href="{{ section.settings.button_link_2 | default: routes.collections_url }}">{{ section.settings.button_label_2 | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if request.design_mode and show_media == false -%}
        <p class="text-only-hint">{{ 'general.placeholder.text_only' | t }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .phero {
    padding-top: var(--pt);
    padding-bottom: var(--pb);
    background: var(--color-bg-gradient);
    color: var(--color-text);
  }
  .phero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: clamp(28px, 4vw, 72px);
    align-items: end;
  }
  .phero--media-end .phero__plate {
    order: 2;
  }
  .phero--stacked .phero__inner,
  .phero--text-only .phero__inner {
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(22px, 3vw, 40px);
  }
  .phero__plate {
    display: grid;
    gap: 10px;
    margin: 0;
    min-width: 0;
  }
  .phero__media {
    position: relative;
    overflow: hidden;
    height: calc(100svh - var(--header-height, 0px) - var(--pt) - 80px);
    min-height: 440px;
    background: var(--tint-1, var(--color-surface));
  }
  .phero__media--large {
    height: 78svh;
  }
  .phero__media--medium {
    height: 60svh;
    min-height: 360px;
  }
  .phero__media .hero-media--two {
    gap: clamp(8px, 1vw, 16px);
    background: var(--color-bg);
  }
  .phero__caption {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .phero__text {
    display: grid;
    gap: 18px;
    align-content: end;
    max-width: 520px;
    padding-bottom: 30px;
  }
  .phero--stacked .phero__text {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    max-width: none;
    align-items: end;
    gap: 18px clamp(28px, 4vw, 72px);
    padding-bottom: 0;
  }
  .phero--stacked .phero__heading {
    grid-row: span 3;
  }
  .phero__eyebrow {
    margin: 0;
    font-size: 1rem;
    color: var(--color-muted);
  }
  .phero__heading {
    margin: 0;
  }
  .phero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .phero__line > span {
    display: inline-block;
  }
  .phero__copy {
    max-width: 44ch;
    color: var(--color-body);
  }
  .phero__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }
  .phero__link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .phero__media .hero-media {
      animation: phero-settle 2.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .phero__line > span {
      animation: phero-rise 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: calc(0.25s + var(--line, 0) * 0.12s);
    }
    .phero__caption {
      animation: phero-fade 1s ease 0.6s both;
    }
  }
  @keyframes phero-settle {
    from {
      scale: 1.07;
    }
  }
  @keyframes phero-rise {
    from {
      translate: 0 105%;
    }
  }
  @keyframes phero-fade {
    from {
      opacity: 0;
    }
  }
  @media (max-width: 989px) {
    .phero__inner,
    .phero--media-end .phero__inner {
      grid-template-columns: minmax(0, 1fr);
    }
    .phero--media-end .phero__plate {
      order: 0;
    }
    .phero--stacked .phero__text {
      grid-template-columns: minmax(0, 1fr);
    }
    .phero__text {
      padding-bottom: 0;
    }
    .phero__media {
      height: 70svh;
      min-height: 360px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Plate hero",
  "tag": "div",
  "class": "plate-hero-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "side", "label": "Photo beside the text" },
        { "value": "stacked", "label": "Photo above the text" }
      ],
      "default": "side"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Photo position",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "end", "label": "End" }
      ],
      "default": "start"
    },
    { "type": "header", "content": "Photo or video" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "image_2", "label": "Second image", "info": "Shown beside the first as a spread. Stacks under it on phones." },
    { "type": "image_picker", "id": "image_mobile", "label": "Phone image", "info": "Replaces the images on phones" },
    { "type": "video", "id": "video", "label": "Video", "info": "Plays muted on a loop instead of the images" },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" },
        { "value": "adapt", "label": "Adapt to the image or video" },
        { "value": "ratio", "label": "Aspect ratio below" }
      ],
      "default": "full",
      "info": "Adapt shows the whole image at its own shape"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        { "value": "2.333", "label": "21:9 cinema" },
        { "value": "1.778", "label": "16:9 wide" },
        { "value": "1.5", "label": "3:2" },
        { "value": "1.333", "label": "4:3" },
        { "value": "1", "label": "1:1 square" },
        { "value": "0.8", "label": "4:5 portrait" },
        { "value": "0.667", "label": "2:3 portrait" }
      ],
      "default": "0.8"
    },
    {
      "type": "select",
      "id": "aspect_ratio_mobile",
      "label": "Aspect ratio on phones",
      "options": [
        { "value": "same", "label": "Same as desktop" },
        { "value": "adapt", "label": "Adapt to the image" },
        { "value": "1", "label": "1:1 square" },
        { "value": "0.8", "label": "4:5 portrait" },
        { "value": "0.667", "label": "2:3 portrait" },
        { "value": "0.5625", "label": "9:16 tall" }
      ],
      "default": "adapt"
    },
    { "type": "text", "id": "caption", "label": "Caption under the photo", "default": "Plate 01 — the new season" },
    { "type": "text", "id": "caption_end", "label": "Caption at the end", "info": "For example where or when the photo was taken" },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Small title", "default": "New arrivals" },
    { "type": "textarea", "id": "heading", "label": "Heading", "info": "Each line rises on its own. Wrap words in *asterisks* to set them in italics.", "default": "Clothes for\nthe *quiet* days" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Everyday pieces in linen, cotton and wool, cut to be worn often.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop new arrivals" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to all products" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Solid" },
        { "value": "secondary", "label": "Outline" }
      ],
      "default": "primary"
    },
    { "type": "text", "id": "button_label_2", "label": "Link label", "default": "All collections" },
    { "type": "url", "id": "button_link_2", "label": "Link" },
    { "type": "header", "content": "Spacing" },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "small"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    }
  ],
  "presets": [{ "name": "Plate hero" }]
}
{% endschema %}
