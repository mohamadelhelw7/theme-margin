{
  "type": "footer",
  "name": "Footer",
  "sections": {
    "footer": {
      "type": "margin-footer",
      "blocks": {
        "newsletter": {
          "type": "_footer-newsletter",
          "settings": {}
        },
        "menu_shop": {
          "type": "_footer-menu",
          "settings": {
            "heading": "Shop",
            "menu": "main-menu"
          }
        },
        "menu_help": {
          "type": "_footer-menu",
          "settings": {
            "heading": "Help",
            "menu": "footer"
          }
        }
      },
      "block_order": [
        "newsletter",
        "menu_shop",
        "menu_help"
      ],
      "settings": {
        "color_scheme": "scheme-1",
        "margin_top": "none",
        "colophon": "<p>Everyday clothes, made in small runs. Write a line about your studio here.</p>",
        "columns": 3,
        "show_policies": true,
        "show_localization": true,
        "show_country": true,
        "show_social": true,
        "show_payment_icons": true,
        "show_powered_by": false
      }
    },
    "popup": {
      "type": "popup",
      "settings": {
        "enable": false,
        "color_scheme": "scheme-2",
        "content": "newsletter",
        "trigger": "scroll",
        "delay": 8,
        "scroll_percent": 40,
        "frequency": 7,
        "pages": "all",
        "show_mobile": true,
        "position": "corner",
        "layout": "stacked",
        "image_position": "start",
        "image_shape": "square",
        "eyebrow": "The club",
        "heading": "New pieces,\n*first*",
        "text": "<p>New arrivals, restocks and the journal, by email.</p>",
        "button_label": "Shop now",
        "dismiss_label": "Not now"
      }
    },
    "tab_bar": {
      "type": "tab-bar",
      "settings": {
        "enable": false,
        "color_scheme": "scheme-2",
        "show_labels": true
      }
    }
  },
  "order": [
    "footer",
    "popup",
    "tab_bar"
  ]
}
