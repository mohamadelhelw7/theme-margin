{%- liquid
  assign journal = section.settings.blog | default: blogs.news
  assign posts_to_show = section.settings.posts_to_show
-%}

<section
  class="section journal-columns color-{{ section.settings.color_scheme }}"
  style="--pt: var(--space-{{ section.settings.padding_top }}); --pb: var(--space-{{ section.settings.padding_bottom }});"
>
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.link_label != blank -%}
      <div class="journal-columns__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="journal-columns__heading h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a class="arrow-link" href="{{ journal.url | default: routes.root_url }}">
            {{- section.settings.link_label | escape -}}
            {% render 'icon', icon: 'arrow' %}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="journal-columns__list" role="list">
      {%- for article in journal.articles limit: posts_to_show -%}
        <li class="journal-columns__item">
          <article class="journal-entry">
            <h3 class="journal-entry__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
            {%- if section.settings.show_excerpt -%}
              <p class="journal-entry__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
            {%- endif -%}
            <p class="journal-entry__meta">
              {%- if section.settings.show_author -%}<span>{{ article.author | escape }}</span>{%- endif -%}
              {%- if section.settings.show_date -%}<time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d · %m · %Y' }}</time>{%- endif -%}
            </p>
          </article>
        </li>
      {%- else -%}
        {%- for i in (1..posts_to_show) -%}
          <li class="journal-columns__item">
            <article class="journal-entry">
              <h3 class="journal-entry__title">{{ 'sections.blog_posts.placeholder_title' | t }}</h3>
              <p class="journal-entry__excerpt">{{ 'sections.journal.placeholder_text' | t }}</p>
              <p class="journal-entry__meta"><span>{{ shop.name | escape }}</span></p>
            </article>
          </li>
        {%- endfor -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .journal-columns__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  .journal-columns__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 64px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .journal-entry {
    display: grid;
    gap: 14px;
    height: 100%;
    grid-template-rows: auto 1fr auto;
    padding-top: 22px;
    border-top: 1px solid var(--color-border);
  }
  .journal-entry__title {
    font-size: calc(clamp(1.25rem, 1.8vw, 1.6rem) * var(--heading-scale));
    text-transform: none;
    letter-spacing: 0;
    line-height: 1.2;
  }
  .journal-entry__title a {
    color: inherit;
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.5s ease;
  }
  .journal-entry__title a:hover {
    background-size: 100% 1px;
  }
  [dir='rtl'] .journal-entry__title a {
    background-position: 100% 100%;
  }
  .journal-entry__excerpt {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-body);
  }
  .journal-entry__meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  @media (max-width: 749px) {
    .journal-columns__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Journal columns",
  "tag": "section",
  "class": "journal-columns-section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the journal" },
    { "type": "blog", "id": "blog", "label": "Blog", "info": "Defaults to your News blog" },
    { "type": "range", "id": "posts_to_show", "label": "Posts", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the journal" },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Top padding",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    }
  ],
  "presets": [{ "name": "Journal columns" }]
}
{% endschema %}
