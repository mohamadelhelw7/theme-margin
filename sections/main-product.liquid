{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign gallery = section.settings.gallery_layout
  assign zoom_id = 'Zoom-' | append: section.id
  assign form_id = 'ProductForm-' | append: section.id
  assign media_count = product.media.size
-%}

{% render 'breadcrumbs' %}

<product-info
  class="section color-{{ section.settings.color_scheme }} main-product"
  data-section="{{ section.id }}"
  data-url="{{ product.url }}"
  data-update-url="true"
  style="--pt: var(--space-{{ section.settings.padding_top }}); --pb: var(--space-{{ section.settings.padding_bottom }}); --media-ratio: {{ section.settings.media_ratio }};"
>
  <div class="page-width main-product__grid main-product__grid--{{ section.settings.media_width }} main-product__grid--media-{{ section.settings.media_position }}">
    <media-gallery
      class="main-product__gallery gallery--{{ gallery }} gallery--fit-{{ section.settings.media_fit }}{% if section.settings.media_ratio == 'natural' %} gallery--natural{% endif %}"
      data-zoom-target="{{ zoom_id }}"
      aria-label="{{ 'products.product.gallery' | t }}"
    >
      <div class="gallery__viewport">
        <ul class="gallery__track" data-gallery-track role="list">
          {%- for media in product.media -%}
            <li
              class="gallery__slide{% if media.id == featured_media.id %} is-featured{% endif %}"
              data-media-id="{{ media.id }}"
            >
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {%- liquid
                    if forloop.first
                      assign media_loading = 'eager'
                    else
                      assign media_loading = 'lazy'
                    endif
                    assign media_alt = media.alt | default: product.title | escape
                  -%}
                  {%- if section.settings.enable_zoom -%}
                    <button type="button" class="gallery__zoom" data-zoom="{{ media.id }}" aria-label="{{ 'products.product.zoom' | t: number: forloop.index }}">
                      {{
                        media
                        | image_url: width: 1800
                        | image_tag:
                          loading: media_loading,
                          widths: '500, 800, 1100, 1400, 1800',
                          sizes: '(min-width: 990px) 55vw, 100vw',
                          alt: media_alt
                      }}
                    </button>
                  {%- else -%}
                    {{
                      media
                      | image_url: width: 1800
                      | image_tag:
                        loading: media_loading,
                        widths: '500, 800, 1100, 1400, 1800',
                        sizes: '(min-width: 990px) 55vw, 100vw',
                        alt: media_alt
                    }}
                  {%- endif -%}
                {%- when 'video', 'external_video' -%}
                  {{ media | media_tag: image_size: '1400x', autoplay: false, loop: false, controls: true }}
                {%- when 'model' -%}
                  {{ media | media_tag: image_size: '1400x' }}
              {%- endcase -%}
            </li>
          {%- else -%}
            <li class="gallery__slide">
              {% render 'media-placeholder', kind: 'product', index: 2 %}
            </li>
          {%- endfor -%}
        </ul>
        <span id="ProductMediaParsed" hidden></span>

        {%- if media_count > 1 -%}
          <button type="button" class="gallery__arrow gallery__arrow--prev" data-gallery-prev aria-label="{{ 'products.product.previous_image' | t }}">
            {% render 'icon', icon: 'chevron-left' %}
          </button>
          <button type="button" class="gallery__arrow gallery__arrow--next" data-gallery-next aria-label="{{ 'products.product.next_image' | t }}">
            {% render 'icon', icon: 'chevron-right' %}
          </button>
        {%- endif -%}
      </div>

      {%- if media_count > 1 -%}
        <ul class="gallery__thumbs" role="list">
          {%- for media in product.media -%}
            <li>
              <button
                type="button"
                class="gallery__thumb"
                data-thumb="{{ media.id }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="{{ 'products.product.view_media' | t: number: forloop.index }}"
              >
                {{ media.preview_image | image_url: width: 160, height: 160, crop: 'center' | image_tag: loading: 'lazy', alt: '' }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
        <div class="gallery__dots" aria-hidden="true">
          {%- for media in product.media -%}
            <button type="button" class="gallery__dot" data-dot="{{ media.id }}" tabindex="-1" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </media-gallery>

    <div class="main-product__info{% if section.settings.sticky_info %} main-product__info--sticky{% endif %}">
      <div class="main-product__info-inner">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>

  {%- if section.settings.sticky_atc != 'off' -%}
    <sticky-atc class="sticky-atc sticky-atc--{{ section.settings.sticky_atc }} color-{{ section.settings.color_scheme }}" data-target="{{ form_id }}">
      <div class="sticky-atc__inner page-width">
        <div class="sticky-atc__media">
          {%- if product.featured_media -%}
            {{ product.featured_media | image_url: width: 120, height: 120, crop: 'center' | image_tag: loading: 'lazy', alt: '' }}
          {%- endif -%}
        </div>
        <div class="sticky-atc__info">
          <span class="sticky-atc__title">{{ product.title | escape }}</span>
          <div data-update="sticky-price">{% render 'price', variant: current_variant %}</div>
        </div>
        <div class="sticky-atc__button" data-update="sticky-button">
          <button
            type="submit"
            form="{{ form_id }}"
            class="button button--primary"
            {% unless current_variant.available %}
              disabled
            {% endunless %}
          >
            {%- if current_variant.available -%}
              {{ 'products.product.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </button>
        </div>
      </div>
    </sticky-atc>
  {%- endif -%}

  <script type="application/json" data-product-variants>
    {{ product.variants | json }}
  </script>
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
</product-info>

{%- if section.settings.enable_zoom and media_count > 0 -%}
  <dialog id="{{ zoom_id }}" class="modal zoom-modal" aria-label="{{ 'products.product.gallery' | t }}">
    <button type="button" class="icon-button modal__close" data-modal-close aria-label="{{ 'general.accessibility.close' | t }}">
      {% render 'icon', icon: 'close' %}
    </button>
    <ul class="zoom-modal__list" role="list">
      {%- for media in product.media -%}
        {%- if media.media_type == 'image' -%}
          <li data-zoom-media="{{ media.id }}">
            {{ media | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '1000, 1600, 2400', sizes: '100vw', alt: media.alt }}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </dialog>
{%- endif -%}

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "class": "main-product-section",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Media" },
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "Gallery layout on desktop",
      "options": [
        { "value": "stacked", "label": "Stacked" },
        { "value": "grid", "label": "Two column grid" },
        { "value": "thumbnails", "label": "Slider with thumbnails" },
        { "value": "carousel", "label": "Slider with dots" }
      ],
      "default": "stacked"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Photos position on desktop",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "end", "label": "End" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "media_width",
      "label": "Media width",
      "options": [
        { "value": "narrow", "label": "Half" },
        { "value": "medium", "label": "Medium" },
        { "value": "wide", "label": "Wide" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Image shape",
      "options": [
        { "value": "1", "label": "Square" },
        { "value": "0.8", "label": "Portrait" },
        { "value": "0.75", "label": "Tall portrait" },
        { "value": "natural", "label": "Original" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "Image fit",
      "options": [
        { "value": "cover", "label": "Fill the frame" },
        { "value": "contain", "label": "Show the whole photo" }
      ],
      "default": "cover"
    },
    { "type": "checkbox", "id": "enable_zoom", "label": "Open photos full screen on click", "default": true },
    { "type": "header", "content": "Product details" },
    { "type": "checkbox", "id": "sticky_info", "label": "Keep details in view while scrolling", "default": true },
    {
      "type": "select",
      "id": "sticky_atc",
      "label": "Sticky add to cart bar",
      "options": [
        { "value": "mobile", "label": "Mobile only" },
        { "value": "always", "label": "Mobile and desktop" },
        { "value": "off", "label": "Off" }
      ],
      "default": "mobile",
      "info": "Appears after shoppers scroll past the main add to cart button"
    },
    { "type": "header", "content": "Spacing" },
    { "type": "select", "id": "padding_top", "label": "Top spacing", "options": [{ "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "medium" },
    { "type": "select", "id": "padding_bottom", "label": "Bottom spacing", "options": [{ "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "small" }
  ]
}
{% endschema %}
