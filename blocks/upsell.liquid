{% doc %}
  Suggests other products on the product page in one of three styles:
  checkboxes that add the extras together with the main product, small cards with their own add button,
  or a compact list. Products come from Shopify's recommendations or are picked by hand.

  @example
  {% content_for 'block', type: 'upsell', id: 'upsell' %}
{% enddoc %}

{%- liquid
  assign upsell_style = block.settings.style
  assign upsell_limit = block.settings.limit
  assign upsell_url = ''
  assign upsell_picked = block.settings.products | size
  assign upsell_use_picked = false
  if block.settings.source == 'picked' or upsell_picked > 0
    assign upsell_use_picked = true
  endif
  if upsell_use_picked == false and product != blank
    assign upsell_url = routes.product_recommendations_url | append: '?product_id=' | append: product.id | append: '&limit=' | append: upsell_limit | append: '&intent=' | append: block.settings.source | append: '&section_id=upsell-render'
  endif
-%}

<product-upsell
  class="upsell upsell--{{ upsell_style }}"
  data-style="{{ upsell_style }}"
  data-limit="{{ upsell_limit }}"
  {% if upsell_url != blank %}
    data-url="{{ upsell_url }}" hidden
  {% endif %}
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <p class="upsell__heading">{{ block.settings.heading | escape }}</p>
  {%- endif -%}
  <div class="upsell__items" data-upsell-target>
    {%- if upsell_use_picked -%}
      {%- for picked in block.settings.products limit: upsell_limit -%}
        {%- if picked.id == product.id -%}{%- continue -%}{%- endif -%}
        {% render 'upsell-option', product: picked, style: upsell_style %}
      {%- endfor -%}
    {%- endif -%}
  </div>
  {%- if upsell_style == 'checkbox' -%}
    <p class="upsell__note">{{ 'products.upsell.added_together' | t }}</p>
  {%- endif -%}
  {%- if request.design_mode and upsell_use_picked and upsell_picked == 0 -%}
    <p class="text-only-hint">{{ 'products.upsell.editor_hint' | t }}</p>
  {%- endif -%}
</product-upsell>

{% javascript %}
  class ProductUpsell extends HTMLElement {
    connectedCallback() {
      this.addEventListener('change', (event) => {
        const select = event.target.closest('[data-upsell-variant]');
        if (!select) return;
        const box = select.closest('[data-upsell-item]')?.querySelector('[data-upsell-addon]');
        if (box) box.value = select.value;
      });
      const url = this.dataset.url;
      if (!url) return;
      ProductUpsell.cache = ProductUpsell.cache || new Map();
      const fill = (doc) => {
        const target = this.querySelector('[data-upsell-target]');
        const results = doc && doc.querySelector(`[data-style="${this.dataset.style}"]`);
        if (!target || !results) return;
        target.innerHTML = results.innerHTML;
        const limit = Number(this.dataset.limit) || 0;
        if (limit) Array.from(target.querySelectorAll('[data-upsell-item]')).slice(limit).forEach((item) => item.remove());
        this.hidden = !target.querySelector('[data-upsell-item]');
      };
      if (ProductUpsell.cache.has(url)) {
        fill(ProductUpsell.cache.get(url));
        return;
      }
      fetch(url)
        .then((response) => response.text())
        .then((html) => {
          const doc = new DOMParser().parseFromString(html, 'text/html');
          ProductUpsell.cache.set(url, doc);
          fill(doc);
        })
        .catch(() => {});
    }
  }
  if (!customElements.get('product-upsell')) customElements.define('product-upsell', ProductUpsell);
{% endjavascript %}

{% stylesheet %}
  product-upsell {
    display: block;
  }
  product-upsell[hidden] {
    display: none;
  }
  .upsell {
    display: grid;
    gap: 12px;
  }
  .upsell__heading {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: var(--label-ls);
    text-transform: var(--label-case);
  }
  .upsell__items {
    display: grid;
    gap: 8px;
  }
  .upsell__note {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  /* Checkboxes added with the main product */
  .upsell-option--checkbox {
    display: grid;
    gap: 8px;
    padding: 10px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .upsell-option--checkbox:has(input:checked) {
    border-color: var(--color-text);
    background: color-mix(in srgb, var(--color-text) 4%, transparent);
  }
  .upsell-option__check {
    display: grid;
    grid-template-columns: auto 52px minmax(0, 1fr);
    align-items: center;
    gap: 12px;
    cursor: pointer;
  }
  .upsell-option__check input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .upsell-option__box {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border: 1px solid var(--color-text);
    border-radius: var(--radius-sm);
  }
  .upsell-option__box .icon {
    width: 14px;
    height: 14px;
    opacity: 0;
  }
  .upsell-option__check input:checked + .upsell-option__box {
    background: var(--color-text);
    color: var(--color-bg);
  }
  .upsell-option__check input:checked + .upsell-option__box .icon {
    opacity: 1;
  }
  .upsell-option__check input:focus-visible + .upsell-option__box {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .upsell-option__media {
    width: 52px;
    height: 52px;
    overflow: hidden;
    background: var(--tint-1);
    border-radius: var(--radius-sm);
  }
  .upsell-option__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .upsell-option__info {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .upsell-option__title {
    font-size: 0.875rem;
    font-weight: 500;
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .upsell-option .price {
    font-size: 0.8125rem;
  }
  .upsell-option__select {
    min-height: 40px;
    font-size: 0.8125rem;
  }

  /* Small cards with their own add button */
  .upsell--cards .upsell__items {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .upsell--cards .upsell__items::-webkit-scrollbar {
    display: none;
  }
  .upsell-option--card {
    flex: 0 0 min(160px, 42%);
    display: grid;
    gap: 6px;
    align-content: start;
    scroll-snap-align: start;
  }
  .upsell-option__card-media {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--tint-1);
    border-radius: var(--radius-sm);
  }
  .upsell-option__card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .upsell-option--card .upsell-option__title {
    white-space: normal;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .upsell-option__form {
    display: grid;
    gap: 6px;
    margin-top: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Upsell",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Goes well with" },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "checkbox", "label": "Checkboxes, added with this product" },
        { "value": "cards", "label": "Small cards with an add button" },
        { "value": "list", "label": "Compact list with an add button" }
      ],
      "default": "checkbox"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Products",
      "options": [
        { "value": "complementary", "label": "Complementary products" },
        { "value": "related", "label": "Related products" },
        { "value": "picked", "label": "Products I pick" }
      ],
      "default": "related",
      "info": "Related products come from Shopify, and complementary ones from the Search & Discovery app. While Shopify has no suggestions for a product yet, the block shows other products from its collection."
    },
    { "type": "product_list", "id": "products", "label": "Products to suggest", "limit": 6, "info": "Products you pick here are always shown, whatever the Products setting says." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 1, "max": 6, "step": 1, "default": 3 }
  ],
  "presets": [
    { "name": "Upsell", "category": "Product" },
    { "name": "Upsell cards", "category": "Product", "settings": { "style": "cards", "heading": "Complete the set" } }
  ]
}
{% endschema %}
