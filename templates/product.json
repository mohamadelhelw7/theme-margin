{
  "sections": {
    "main": {
      "type": "main-catalogue",
      "blocks": {
        "price": {
          "type": "product-price",
          "static": true,
          "settings": {}
        },
        "description": {
          "type": "product-description",
          "static": true,
          "settings": {}
        },
        "details": {
          "type": "accordion",
          "settings": {
            "style": "lines",
            "single_open": true
          },
          "blocks": {
            "row_1": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Size and fit",
                "icon": "ruler",
                "content": "<p>Describe how this piece fits, and when to size up or down.</p>"
              }
            },
            "row_2": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Materials and care",
                "icon": "leaf",
                "content": "<p>Describe the fabric and how to wash it so the print lasts.</p>"
              }
            },
            "row_3": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Shipping and returns",
                "icon": "truck",
                "content": "<p>Write your delivery times, fees and return policy here.</p>"
              }
            }
          },
          "block_order": [
            "row_1",
            "row_2",
            "row_3"
          ],
          "static": true
        },
        "variants": {
          "type": "variant-picker",
          "settings": {}
        },
        "size_guide": {
          "type": "size-guide",
          "settings": {}
        },
        "stock": {
          "type": "inventory-status",
          "settings": {}
        },
        "buy": {
          "type": "buy-buttons",
          "settings": {}
        },
        "upsell": {
          "type": "upsell",
          "settings": {
            "heading": "Pairs with",
            "style": "checkbox",
            "source": "related",
            "limit": 3
          }
        },
        "restock": {
          "type": "restock-alert",
          "settings": {}
        },
        "save": {
          "type": "save-button",
          "settings": {}
        },
        "timeline": {
          "type": "delivery-timeline",
          "settings": {
            "ship_days": 1,
            "min_days": 1,
            "max_days": 3,
            "cutoff_hour": 14,
            "show_countdown": true,
            "skip_friday": true,
            "skip_saturday": false,
            "skip_sunday": false
          }
        },
        "payments": {
          "type": "payment-icons",
          "settings": {}
        },
        "whatsapp": {
          "type": "whatsapp-button",
          "settings": {}
        }
      },
      "block_order": [
        "variants",
        "size_guide",
        "stock",
        "buy",
        "upsell",
        "restock",
        "save",
        "timeline",
        "payments",
        "whatsapp"
