      "settings": {
        "color_scheme": "scheme-1",
        "plates_layout": "stacked",
        "plates_position": "start",
        "photo_ratio": "0.8",
        "media_fit": "cover",
        "show_captions": true,
        "show_collection": true,
        "show_description": true,
        "sticky_atc": "mobile"
